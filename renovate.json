{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["xunit*", "!Xunit.StaFact"],
      "groupName": "xunit"
    }
  ]
}
