
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>lg2de.SimpleAccounting</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Authors>Lukas Grützmacher</Authors>
    <Copyright>Copyright © 2007-2026</Copyright>
    <InformationalVersion>DEVEL</InformationalVersion>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <WarningsAsErrors>true</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Reports\*.xml" />
    <None Remove="UpdateApplication.ps1" />
    <EmbeddedResource Include="Reports\*.xml" />
    <EmbeddedResource Include="Scripts\*.ps1"/>
  </ItemGroup>

  <ItemGroup>
    <!-- licecnse is MIT -->
    <PackageReference Include="Caliburn.Micro" Version="5.0.258" />
    <!-- license is MS-PL -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <!-- licecnse is MIT -->
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <!-- license is MIT, used for detect encoding of imported CSV files, unit test verified -->
    <PackageReference Include="MagicFileEncoding" Version="4.0.0" />
    <!-- license is MIT -->
    <PackageReference Include="Octokit" Version="14.0.0"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!--
    The model classes are generated from the schema by XmlSchemaClassGenerator (local dotnet tool, see dotnet-tools.json).
    The generation runs for local builds if the schema (or this project file) has been changed.
    It is skipped in CI to build exactly the committed code.
    Relative paths are used because the command line is written into the generated file.
  -->
  <Target
    Name="GenerateModel"
    BeforeTargets="BeforeBuild"
    Condition="'$(CI)' != 'true'"
    Inputs="Model\AccountingData.xsd;$(MSBuildProjectFullPath)"
    Outputs="Model\AccountingData.designer.cs">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" StandardOutputImportance="low" />
    <Exec
      Command="dotnet xscgen -n lg2de.SimpleAccounting.Model -o obj\xscgen --ct System.Collections.Generic.List`1 --csm PublicWithoutConstructorInitialization --cc- --namingScheme=Direct Model\AccountingData.xsd"
      WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Copy
      SourceFiles="obj\xscgen\lg2de.SimpleAccounting.Model.cs"
      DestinationFiles="Model\AccountingData.designer.cs" />
  </Target>

  <!--
    The schema is published by GitHub Pages from the docs folder (referenced by the project files).
    Keep the published copy in sync for local builds. It is skipped in CI to let the unit test detect missing commits.
  -->
  <Target Name="CopySchemaToDocs" AfterTargets="Build" Condition="'$(CI)' != 'true'">
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\Model\AccountingData.xsd"
      DestinationFolder="$(MSBuildProjectDirectory)\..\..\docs"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
