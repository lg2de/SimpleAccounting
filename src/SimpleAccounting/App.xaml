<Application
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:lg2de.SimpleAccounting"
    xmlns:presentation="clr-namespace:lg2de.SimpleAccounting.Presentation"
    x:Class="lg2de.SimpleAccounting.App"
    Startup="ApplicationStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Fluent theme (Windows 11 look), follows the system light/dark setting -->
                <ResourceDictionary
                    Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
                <!--
                  The bootstrapper must be part of a merged dictionary.
                  Keyed resources of the main dictionary are created on first access only,
                  so the bootstrapper would never be instantiated.
                -->
                <ResourceDictionary>
                    <local:AppBootstrapper x:Key="Bootstrapper" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- no margin: the Fluent ComboBox and ComboBoxItem provide the spacing -->
            <DataTemplate x:Key="AccountSelectionTemplate">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding Name}" />
                    <Run Text="{Binding ID, StringFormat=({0})}" />
                </TextBlock>
            </DataTemplate>

            <!--
              The implicit styles below must be based on the Fluent styles.
              Otherwise, they would replace the Fluent styles completely.
              Use the named Fluent styles here: within this dictionary, "{StaticResource {x:Type Button}}"
              resolves to the classic system style instead of the Fluent style.
            -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>

            <!--
              Layout of all dialogs, similar to the Windows 11 content dialog:
              brighter content area with spacing, darker button area separated by a line.
              Together with the margin of the controls (5) the spacing to the window border is 24 (content)
              and 20 (buttons, vertical).
            -->
            <Style x:Key="DialogContentStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
                <Setter Property="Padding" Value="19" />
            </Style>
            <Style x:Key="DialogFooterStyle" TargetType="Border">
                <Setter Property="DockPanel.Dock" Value="Bottom" />
                <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0 1 0 0" />
                <Setter Property="Padding" Value="19 15" />
            </Style>
            <Style x:Key="DialogButtonPanelStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <!-- glyph of "Segoe Fluent Icons" like the message dialog, the color is set by the user -->
            <Style x:Key="DialogIconStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0 0 16 0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="32" />
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="Margin" Value="5" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Margin" Value="5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="Margin" Value="5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="presentation:NumberTextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="Margin" Value="5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="DatePicker" BasedOn="{StaticResource DefaultDatePickerStyle}">
                <Setter Property="Margin" Value="5" />
            </Style>
            <!-- Fluent does not show disabled tabs differently -->
            <Style TargetType="TabItem" BasedOn="{StaticResource DefaultTabItemStyle}">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
              Similar to the Fluent cell template, but the content gets a padding and is centered vertically.
              The Fluent template ignores Padding and VerticalContentAlignment.
              The selection is a translucent accent overlay instead of a solid accent background with
              inverted text. This keeps all cell contents (text and embedded controls) readable.
            -->
            <Style x:Key="DataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="6 0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border
                                x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                                <Grid>
                                    <Rectangle
                                        x:Name="SelectionOverlay"
                                        Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                        Opacity="0.35"
                                        Visibility="Collapsed" />
                                    <ContentPresenter
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="SelectionOverlay" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <!-- simple resource key: the Rider XAML preview fails on component resource keys -->
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Border" Property="BorderThickness" Value="1" />
                                    <Setter TargetName="Border" Property="BorderBrush"
                                            Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="DataGrid" BasedOn="{StaticResource DefaultDataGridStyle}">
                <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}" />
            </Style>
            <Style x:Key="ValueGridStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="2 0 2 0" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
