<Window
  x:Class="lg2de.SimpleAccounting.Presentation.MessageDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  SizeToContent="WidthAndHeight"
  MinWidth="320" MaxWidth="640"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Window.CommandBindings>
    <!-- Ctrl+C copies the whole message like the Win32 message box -->
    <CommandBinding Command="Copy" Executed="OnCopyExecuted" />
  </Window.CommandBindings>
  <DockPanel>
    <Border Style="{StaticResource DialogFooterStyle}">
      <ItemsControl x:Name="ButtonsPanel" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Style="{StaticResource DialogButtonPanelStyle}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Border>
    <Border Style="{StaticResource DialogContentStyle}">
      <Grid Margin="5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
          x:Name="IconText"
          Grid.Column="0"
          Style="{StaticResource DialogIconStyle}"
          Visibility="Collapsed" />
        <TextBlock
          x:Name="MessageText"
          Grid.Column="1"
          VerticalAlignment="Center"
          TextWrapping="Wrap" />
      </Grid>
    </Border>
  </DockPanel>
</Window>
