<Window
  x:Class="lg2de.SimpleAccounting.Presentation.MessageDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  SizeToContent="WidthAndHeight"
  MinWidth="320" MaxWidth="640"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner">
  <!-- layout like the Windows 11 content dialog: brighter content area, darker button area -->
  <DockPanel>
    <Border
      DockPanel.Dock="Bottom"
      Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0 1 0 0"
      Padding="19 15">
      <ItemsControl x:Name="ButtonsPanel" HorizontalAlignment="Right">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Border>
    <Border Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
      <Grid Margin="24 24 24 20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
          x:Name="IconText"
          Grid.Column="0"
          Margin="0 0 16 0"
          VerticalAlignment="Top"
          FontFamily="{DynamicResource SymbolThemeFontFamily}"
          FontSize="32"
          Visibility="Collapsed" />
        <TextBlock
          x:Name="MessageText"
          Grid.Column="1"
          VerticalAlignment="Center"
          TextWrapping="Wrap" />
      </Grid>
    </Border>
  </DockPanel>
</Window>
