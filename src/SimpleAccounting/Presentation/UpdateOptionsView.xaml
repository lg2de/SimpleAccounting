<UserControl
  x:Class="lg2de.SimpleAccounting.Presentation.UpdateOptionsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:lg2de.SimpleAccounting.Presentation"
  xmlns:properties="clr-namespace:lg2de.SimpleAccounting.Properties"
  mc:Ignorable="d"
  Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  d:DataContext="{d:DesignInstance Type=local:UpdateOptionsDesignViewModel, IsDesignTimeCreatable=True}">
  <DockPanel>
    <Border Style="{StaticResource DialogFooterStyle}">
      <StackPanel Style="{StaticResource DialogButtonPanelStyle}">
        <Button Content="{x:Static properties:Resources.Update_SkipVersion}" IsCancel="True" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource DialogContentStyle}">
      <StackPanel Orientation="Vertical" MinWidth="300" MaxWidth="560">
        <TextBlock
          Margin="5 5 5 15"
          TextWrapping="Wrap"
          Text="{Binding Text}" />
        <!-- each option selects one of the packages for the update -->
        <ItemsControl ItemsSource="{Binding Options}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button
                HorizontalAlignment="Stretch"
                Content="{Binding Text}" Command="{Binding Command}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </DockPanel>
</UserControl>
